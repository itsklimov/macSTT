default_platform(:mac)

require "shellwords"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)
PROJECT_YML = File.join(ROOT, "project.yml")
APP_NAME = "macSTT"
APP_BUNDLE_ID = "com.wixfi.stt"
DMG_BUNDLE_ID = "#{APP_BUNDLE_ID}.dmg"
XCODE_PROJECT_NAME = "macSTT"
XCODE_SCHEME = "macSTT"
ENTITLEMENTS_PATH = File.join(ROOT, "Support", "macSTT.entitlements")
RELEASES_REPO = "itsklimov/macSTT"
RELEASES_REPO_URL = "https://github.com/#{RELEASES_REPO}"
APPCAST_BRANCH = "gh-pages"
RELEASES_RAW_URL = "https://raw.githubusercontent.com/#{RELEASES_REPO}/#{APPCAST_BRANCH}"
SPARKLE_BIN_DIRECTORIES = [
  File.join(ROOT, ".build", "artifacts", "sparkle", "Sparkle", "bin"),
  File.join(ROOT, ".build", "checkouts", "Sparkle", "bin"),
  File.join(ROOT, ".build", "index-build", "artifacts", "sparkle", "Sparkle", "bin"),
  File.join(ROOT, ".build", "index-build", "checkouts", "Sparkle", "bin")
].freeze
DMG_VOLUME_NAME = APP_NAME
DMG_BACKGROUND_FILENAME = "background.png"
DMG_WINDOW_BOUNDS = [160, 120, 800, 500].freeze
DMG_ICON_SIZE = 128
DMG_TEXT_SIZE = 14
DMG_APP_ICON_POSITION = [150, 180].freeze
DMG_APPLICATIONS_ICON_POSITION = [490, 180].freeze
DMG_BACKGROUND_SIZE = [640, 380].freeze
APP_ICONSET_PATH = File.join(ROOT, "Sources", "macSTT", "Assets.xcassets", "AppIcon.appiconset")
APP_ICON_FILENAME = "AppIcon.icns"
OFFICIAL_SPARKLE_FEED_URL = "#{RELEASES_RAW_URL}/appcast.xml"
SPARKLE_KEYCHAIN_SERVICE = "https://sparkle-project.org"
SPARKLE_KEYCHAIN_ACCOUNT = "ed25519"

def read_project_yml
  File.read(PROJECT_YML)
rescue => e
  UI.user_error!("Failed to read #{PROJECT_YML}: #{e.message}")
end

def extract_required_capture(content, pattern, description, source)
  match = content.match(pattern)
  UI.user_error!("Could not find #{description} in #{source}") unless match
  match[1]
end

def replace_exactly_once(content, needle, replacement, description, source)
  count = content.scan(Regexp.new(Regexp.escape(needle))).size
  UI.user_error!("Expected exactly one #{description} in #{source}, found #{count}") unless count == 1
  content.sub(needle, replacement)
end

def current_version(content = read_project_yml)
  extract_required_capture(content, /MARKETING_VERSION: "(\d+\.\d+\.\d+)"/, "MARKETING_VERSION", PROJECT_YML)
end

def current_build_number(content = read_project_yml)
  extract_required_capture(content, /CURRENT_PROJECT_VERSION: "(\d+)"/, "CURRENT_PROJECT_VERSION", PROJECT_YML).to_i
end

def sparkle_tool(tool)
  path = SPARKLE_BIN_DIRECTORIES
    .map { |directory| File.join(directory, tool) }
    .find { |candidate| File.executable?(candidate) }

  UI.user_error!("Could not find Sparkle tool #{tool}. Run `swift build` first.") unless path
  path
end

def release_tag_url(tag)
  "#{RELEASES_REPO_URL}/releases/tag/#{tag}"
end

def release_asset_name(version)
  "#{APP_NAME}-#{version}.dmg"
end

def release_notes_name(version)
  "#{APP_NAME}-#{version}.md"
end

def app_bundle_path
  File.join(ROOT, "build", "#{APP_NAME}.app")
end

def build_xcargs(enable_sparkle:)
  arguments = []

  team_id = ENV["DEVELOPMENT_TEAM"].to_s.strip
  arguments << "DEVELOPMENT_TEAM=#{team_id.shellescape}" unless team_id.empty?

  if enable_sparkle
    public_key = ENV["SPARKLE_PUBLIC_ED_KEY"].to_s.strip
    UI.user_error!("SPARKLE_PUBLIC_ED_KEY not set") if public_key.empty?

    arguments << "ENABLE_SPARKLE=YES"
    arguments << "SPARKLE_FEED_URL=#{OFFICIAL_SPARKLE_FEED_URL.shellescape}"
    arguments << "SPARKLE_PUBLIC_ED_KEY=#{public_key.shellescape}"
  else
    arguments << "ENABLE_SPARKLE=NO"
    arguments << "SPARKLE_FEED_URL=''"
    arguments << "SPARKLE_PUBLIC_ED_KEY=''"
  end

  arguments.join(" ")
end

def sparkle_keychain_present?
  system(
    "security",
    "find-generic-password",
    "-s", SPARKLE_KEYCHAIN_SERVICE,
    "-a", SPARKLE_KEYCHAIN_ACCOUNT,
    out: File::NULL,
    err: File::NULL
  )
end

def ensure_sparkle_private_key!
  return if sparkle_keychain_present?

  private_key = ENV["SPARKLE_PRIVATE_KEY"].to_s.strip
  UI.user_error!("SPARKLE_PRIVATE_KEY not set and no Sparkle signing key found in login keychain") if private_key.empty?

  Dir.mktmpdir("macstt-sparkle-private-key") do |dir|
    key_path = File.join(dir, "sparkle_private_key")
    File.write(key_path, private_key)
    sh(sparkle_tool("generate_keys"), "-f", key_path)
  end
end

def appcast_branch_exists?(repository_path)
  system(
    "cd #{repository_path.shellescape} && git ls-remote --exit-code --heads origin #{APPCAST_BRANCH}",
    out: File::NULL,
    err: File::NULL
  )
end

def checkout_appcast_branch(repository_path)
  if appcast_branch_exists?(repository_path)
    sh("cd #{repository_path} && git fetch --depth 1 origin #{APPCAST_BRANCH}")
    sh("cd #{repository_path} && git checkout -B #{APPCAST_BRANCH} FETCH_HEAD")
    return
  end

  sh("cd #{repository_path} && git checkout --orphan #{APPCAST_BRANCH}")
  sh("cd #{repository_path} && find . -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +")
end

def prune_appcast_branch_contents(repository_path)
  Dir.children(repository_path).each do |entry|
    next if entry == ".git"
    next if entry == "appcast.xml"
    next if entry.match?(/\A#{Regexp.escape(APP_NAME)}-\d+\.\d+\.\d+\.md\z/)

    FileUtils.rm_rf(File.join(repository_path, entry))
  end
end

def staple_and_validate(path, type:)
  sh("xcrun", "stapler", "staple", path)
  sh("xcrun", "stapler", "validate", path)

  case type
  when :app
    sh("codesign", "--verify", "--deep", "--strict", path)
    sh("spctl", "-a", "-vvv", path)
  when :dmg
    sh("spctl", "-a", "-vvv", "-t", "open", "--context", "context:primary-signature", path)
  else
    UI.user_error!("Unknown validation type #{type.inspect}")
  end
end

def ruby_string_literal(value)
  value.to_s.dump
end

def developer_id_application_identity
  team_id = ENV["DEVELOPMENT_TEAM"]
  UI.user_error!("DEVELOPMENT_TEAM not set") unless team_id

  identities = `security find-identity -v -p codesigning`
  preferred = identities.lines.find do |line|
    line.include?('Developer ID Application:') && line.include?("(#{team_id})")
  end
  fallback = identities.lines.find { |line| line.include?('Developer ID Application:') }
  identity_line = preferred || fallback
  UI.user_error!("Developer ID Application identity not found in keychain") unless identity_line

  extract_required_capture(identity_line, /"([^"]+)"/, "Developer ID Application identity", "security find-identity output")
end

def build_app_icns(output_path)
  Dir.mktmpdir("macstt-app-icon") do |dir|
    iconset_path = File.join(dir, "AppIcon.iconset")
    FileUtils.mkdir_p(iconset_path)

    Dir.glob(File.join(APP_ICONSET_PATH, "*.png")).sort.each do |source_path|
      next if File.basename(source_path) == "icon_1024x1024.png"

      FileUtils.cp(source_path, File.join(iconset_path, File.basename(source_path)))
    end

    sh("iconutil", "-c", "icns", iconset_path, "-o", output_path)
  end
end

def replace_bundled_app_icon(app_path)
  output_path = File.join(app_path, "Contents", "Resources", APP_ICON_FILENAME)
  build_app_icns(output_path)
end

def resign_app(app_path)
  sh(
    "codesign",
    "--force",
    "--options", "runtime",
    "--timestamp",
    "--sign", developer_id_application_identity,
    "--entitlements", ENTITLEMENTS_PATH,
    app_path
  )
end

def generate_dmg_background(output_path)
  width, height = DMG_BACKGROUND_SIZE
  swift_source = <<~SWIFT
    import AppKit

    let outputURL = URL(fileURLWithPath: CommandLine.arguments[1])
    let size = NSSize(width: #{width}, height: #{height})
    guard let bitmap = NSBitmapImageRep(
      bitmapDataPlanes: nil,
      pixelsWide: Int(size.width),
      pixelsHigh: Int(size.height),
      bitsPerSample: 8,
      samplesPerPixel: 4,
      hasAlpha: true,
      isPlanar: false,
      colorSpaceName: .deviceRGB,
      bytesPerRow: 0,
      bitsPerPixel: 0
    ) else {
      fputs("Failed to allocate DMG background bitmap\\n", stderr)
      exit(1)
    }

    bitmap.size = size
    guard let context = NSGraphicsContext(bitmapImageRep: bitmap) else {
      fputs("Failed to create DMG background graphics context\\n", stderr)
      exit(1)
    }

    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = context

    NSColor(calibratedRed: 0.97, green: 0.97, blue: 0.965, alpha: 1).setFill()
    NSBezierPath(rect: NSRect(origin: .zero, size: size)).fill()

    let arrowColor = NSColor(calibratedRed: 0.55, green: 0.59, blue: 0.64, alpha: 0.9)

    let shaft = NSBezierPath()
    shaft.move(to: NSPoint(x: 272, y: 190))
    shaft.line(to: NSPoint(x: 366, y: 190))
    shaft.lineWidth = 18
    shaft.lineCapStyle = .round
    arrowColor.setStroke()
    shaft.stroke()

    let head = NSBezierPath()
    head.move(to: NSPoint(x: 340, y: 224))
    head.line(to: NSPoint(x: 380, y: 190))
    head.line(to: NSPoint(x: 340, y: 156))
    head.lineWidth = 18
    head.lineCapStyle = .round
    head.lineJoinStyle = .round
    arrowColor.setStroke()
    head.stroke()

    NSGraphicsContext.restoreGraphicsState()

    guard let png = bitmap.representation(using: .png, properties: [:]) else {
      fputs("Failed to render DMG background\\n", stderr)
      exit(1)
    }

    do {
      try png.write(to: outputURL)
    } catch {
      fputs("Failed to write DMG background: \\(error)\\n", stderr)
      exit(1)
    }
  SWIFT

  Dir.mktmpdir("macstt-dmg-background") do |dir|
    script_path = File.join(dir, "background.swift")
    File.write(script_path, swift_source)
    sh("swift", script_path, output_path)
  end
end

def configure_dmg_window(mounted_path, app_name)
  left, top, right, bottom = DMG_WINDOW_BOUNDS
  app_x, app_y = DMG_APP_ICON_POSITION
  applications_x, applications_y = DMG_APPLICATIONS_ICON_POSITION
  volume_name = File.basename(mounted_path)

  applescript = <<~APPLESCRIPT
    set volumeName to #{ruby_string_literal(volume_name)}
    set appName to #{ruby_string_literal(app_name)}

    tell application "Finder"
      tell disk volumeName
        open
        delay 1
        tell container window
          set current view to icon view
          set toolbar visible to false
          set statusbar visible to false
          set bounds to {#{left}, #{top}, #{right}, #{bottom}}
        end tell

        set viewOptions to the icon view options of container window
        set arrangement of viewOptions to not arranged
        set icon size of viewOptions to #{DMG_ICON_SIZE}
        set text size of viewOptions to #{DMG_TEXT_SIZE}
        set background picture of viewOptions to file ".background:#{DMG_BACKGROUND_FILENAME}"

        set position of item appName of container window to {#{app_x}, #{app_y}}
        set position of item "Applications" of container window to {#{applications_x}, #{applications_y}}

        close
        open
        update without registering applications
        delay 2
      end tell

      set selection to {}
    end tell
  APPLESCRIPT

  sh("osascript", "-e", applescript)
  sh("SetFile", "-a", "V", File.join(mounted_path, ".background"))
end

def build_install_dmg(app_path, dmg_path)
  app_name = File.basename(app_path)

  Dir.mktmpdir("macstt-dmg") do |dir|
    stage_dir = File.join(dir, "stage")
    rw_dmg_path = File.join(dir, "#{APP_NAME}-rw.dmg")
    background_dir = File.join(stage_dir, ".background")
    background_path = File.join(background_dir, DMG_BACKGROUND_FILENAME)

    FileUtils.mkdir_p(background_dir)
    sh("ditto", app_path, File.join(stage_dir, app_name))
    File.symlink("/Applications", File.join(stage_dir, "Applications"))
    generate_dmg_background(background_path)

    sh(
      "hdiutil", "create",
      "-fs", "HFS+",
      "-volname", DMG_VOLUME_NAME,
      "-srcfolder", stage_dir,
      "-ov",
      "-format", "UDRW",
      rw_dmg_path
    )

    mount_path = nil
    attached = false

    begin
      attach_output = sh(
        "hdiutil", "attach",
        "-readwrite",
        "-noverify",
        "-noautoopen",
        "-plist",
        rw_dmg_path
      )
      mount_path = extract_required_capture(
        attach_output,
        %r{<key>mount-point</key>\s*<string>([^<]+)</string>},
        "disk image mount point",
        "hdiutil attach output"
      )
      attached = true

      configure_dmg_window(mount_path, app_name)
      sleep 1
      sh("sync")
    ensure
      sh("hdiutil", "detach", mount_path) if attached && mount_path
    end

    sh(
      "hdiutil", "convert",
      rw_dmg_path,
      "-ov",
      "-format", "UDZO",
      "-imagekey", "zlib-level=9",
      "-o", dmg_path
    )
  end
end

def sign_dmg(dmg_path)
  sh(
    "codesign",
    "--force",
    "--timestamp",
    "--sign", developer_id_application_identity,
    "-i", DMG_BUNDLE_ID,
    dmg_path
  )
end

def bump_version(component)
  content = read_project_yml
  old = current_version(content)
  parts = old.split(".").map(&:to_i)

  case component
  when :patch
    parts[2] += 1
  when :minor
    parts[1] += 1
    parts[2] = 0
  when :major
    parts[0] += 1
    parts[1] = 0
    parts[2] = 0
  end

  new_version = parts.join(".")
  new_build = current_build_number(content) + 1
  content = replace_exactly_once(
    content,
    "MARKETING_VERSION: \"#{old}\"",
    "MARKETING_VERSION: \"#{new_version}\"",
    "MARKETING_VERSION",
    PROJECT_YML
  )
  content = replace_exactly_once(
    content,
    "CURRENT_PROJECT_VERSION: \"#{new_build - 1}\"",
    "CURRENT_PROJECT_VERSION: \"#{new_build}\"",
    "CURRENT_PROJECT_VERSION",
    PROJECT_YML
  )

  File.write(PROJECT_YML, content)
  UI.success("Version: #{old} → #{new_version} (build #{new_build})")
  new_version
end

def write_release_notes(destination_path, tag)
  require "json"

  release = JSON.parse(sh("gh", "release", "view", tag, "--repo", RELEASES_REPO, "--json", "body,url"))
  url = release.fetch("url")
  body = release.fetch("body", "").to_s.strip

  content = if body.empty?
    "See the GitHub release for details.\n\n[View release on GitHub](#{url})\n"
  else
    "#{body}\n\n[View release on GitHub](#{url})\n"
  end

  File.write(destination_path, content)
  url
end

def generate_appcast(archives_dir, tag)
  sh(
    sparkle_tool("generate_appcast"),
    "--download-url-prefix", "#{RELEASES_REPO_URL}/releases/download/#{tag}/",
    "--release-notes-url-prefix", "#{RELEASES_RAW_URL}/",
    "--full-release-notes-url", release_tag_url(tag),
    "--maximum-deltas", "0",
    "--maximum-versions", "0",
    "-o", File.join(archives_dir, "appcast.xml"),
    archives_dir
  )
end

platform :mac do
  desc "Generate Xcode project from project.yml"
  lane :generate do
    sh("cd #{ROOT} && xcodegen generate")
  end

  desc "Build signed .app with Developer ID"
  lane :build do |options|
    UI.user_error!("DEVELOPMENT_TEAM not set") unless ENV["DEVELOPMENT_TEAM"]

    enable_sparkle = options[:enable_sparkle] == true
    generate
    sh("cd #{ROOT} && swift build")

    gym(
      project: File.join(ROOT, "#{XCODE_PROJECT_NAME}.xcodeproj"),
      scheme: XCODE_SCHEME,
      configuration: "Release",
      output_directory: File.join(ROOT, "build"),
      output_name: APP_NAME,
      clean: true,
      export_method: "developer-id",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Developer ID Application",
        teamID: ENV["DEVELOPMENT_TEAM"]
      },
      xcargs: build_xcargs(enable_sparkle: enable_sparkle)
    )

    app_path = app_bundle_path
    replace_bundled_app_icon(app_path)
    resign_app(app_path)
  end

  desc "Build local preview DMG without release side effects"
  lane :dmg do
    version = current_version
    release_name = release_asset_name(version)
    app_path = app_bundle_path
    dmg_path = File.join(ROOT, "build", release_name)

    build(enable_sparkle: false)

    File.delete(dmg_path) if File.exist?(dmg_path)
    build_install_dmg(app_path, dmg_path)

    UI.success("Built preview DMG at #{dmg_path}")
    sh("open", dmg_path) if ENV["OPEN_DMG"] == "1"
  end

  desc "Publish the current version without bumping"
  lane :publish do
    do_release(version: current_version)
  end

  desc "Release: bump patch (0.0.x), build, notarize, dmg, publish"
  lane :release do
    version = bump_version(:patch)
    do_release(version: version)
  end

  desc "Patch release: bump patch (0.0.x), build, notarize, dmg, publish"
  lane :patch do
    version = bump_version(:patch)
    do_release(version: version)
  end

  desc "Minor release: bump minor (0.x.0), build, notarize, dmg, publish"
  lane :minor do
    version = bump_version(:minor)
    do_release(version: version)
  end

  desc "Major release: bump major (x.0.0), build, notarize, dmg, publish"
  lane :major do
    version = bump_version(:major)
    do_release(version: version)
  end

  private_lane :do_release do |options|
    version = options[:version] || current_version
    tag = "v#{version}"
    build_number = current_build_number
    release_name = release_asset_name(version)
    release_notes_filename = release_notes_name(version)

    ensure_sparkle_private_key!
    build(enable_sparkle: true)

    app_path = app_bundle_path
    dmg_path = File.join(ROOT, "build", release_name)
    releases_dir = File.join(ROOT, ".releases-tmp")
    feed_dir = File.join(ROOT, ".appcast-tmp")

    File.delete(dmg_path) if File.exist?(dmg_path)
    FileUtils.rm_rf(releases_dir)
    FileUtils.rm_rf(feed_dir)

    notarize(
      package: app_path,
      bundle_id: APP_BUNDLE_ID,
      asc_provider: ENV["DEVELOPMENT_TEAM"],
      print_log: true
    )
    staple_and_validate(app_path, type: :app)

    build_install_dmg(app_path, dmg_path)
    sign_dmg(dmg_path)
    notarize(
      package: dmg_path,
      bundle_id: DMG_BUNDLE_ID,
      asc_provider: ENV["DEVELOPMENT_TEAM"],
      print_log: true
    )
    staple_and_validate(dmg_path, type: :dmg)

    # Commit version bump to the source repo
    git_add = "project.yml"
    sh("cd #{ROOT} && git add #{git_add} && git commit -m 'Release #{tag}'")
    sh("cd #{ROOT} && git tag #{tag}")
    sh("cd #{ROOT} && git push && git push --tags")

    # Upload release assets to the public repo
    sh("gh", "release", "create", tag, dmg_path, "--repo", RELEASES_REPO, "--title", tag, "--generate-notes")

    # Push appcast to the public repo without polluting the source branch
    sh("gh repo clone #{RELEASES_REPO} #{releases_dir} -- --depth 1")
    checkout_appcast_branch(releases_dir)
    prune_appcast_branch_contents(releases_dir)
    FileUtils.mkdir_p(feed_dir)
    existing_appcast = File.join(releases_dir, "appcast.xml")
    FileUtils.cp(existing_appcast, File.join(feed_dir, "appcast.xml")) if File.exist?(existing_appcast)

    release_notes_path = File.join(feed_dir, release_notes_filename)
    write_release_notes(release_notes_path, tag)
    FileUtils.cp(dmg_path, File.join(feed_dir, release_name))
    generate_appcast(feed_dir, tag)

    FileUtils.cp(File.join(feed_dir, "appcast.xml"), File.join(releases_dir, "appcast.xml"))
    FileUtils.cp(release_notes_path, File.join(releases_dir, release_notes_filename))
    push_command = "git push --set-upstream origin #{APPCAST_BRANCH}"
    sh("cd #{releases_dir} && git add appcast.xml #{release_notes_filename} && git commit -m 'Update appcast for #{tag} (build #{build_number})' && #{push_command}")

    FileUtils.rm_rf(releases_dir)
    FileUtils.rm_rf(feed_dir)

    UI.success("Released #{tag} — #{release_tag_url(tag)}")
  end
end
